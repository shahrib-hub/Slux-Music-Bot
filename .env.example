# ═══════════════════════════════════════════════════════════════════
# BACKEND (bot + API + socket) — runs on Wispbyte / any Node 20+ host
# ═══════════════════════════════════════════════════════════════════
NODE_ENV=production

# The PUBLIC URL browsers use — with the Vercel proxy setup this is your
# VERCEL URL (e.g. https://slux.vercel.app). The Discord OAuth redirect is:
#   ${APP_URL}/api/auth/callback
# (Vercel's vercel.json rewrites forward it to this backend.)
APP_URL=https://your-app.vercel.app

# Bind address + port (Wispbyte: the port your panel allocated)
HOST=0.0.0.0
PORT=3001

# ── Discord (https://discord.com/developers/applications) ───────────
# Enable the "Message Content" privileged intent on the Bot page.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Only needed when the dashboard is enabled
DISCORD_CLIENT_SECRET=

# ── Database ────────────────────────────────────────────────────────
# MongoDB Atlas works great for split deployments
MONGODB_URI=mongodb://localhost:27017/slux

# ── Session ─────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Only needed when the dashboard is enabled
SESSION_SECRET=

# ── Dashboard ───────────────────────────────────────────────────────
# Master switch: set false to run a pure bot — no API, no socket server,
# no dashboard links in embeds, and no OAuth secrets required.
DASHBOARD_ENABLED=true

# Where the dashboard frontend lives. Defaults to APP_URL (the Vercel URL)
# — only set this separately if you host the frontend somewhere else.
DASHBOARD_URL=

# ── Lavalink: main node (3rd-party) ─────────────────────────────────
# The node must run LavaSrc + LavaSearch + LavaLyrics plugins.
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASS=youshallnotpass
# Set true for TLS (wss/https) nodes — most hosted nodes use this.
LAVALINK_SECURE=false
LAVALINK_NAME=main

# ── Lavalink: optional backup node (automatic failover) ─────────────
# When the main node is offline or busy, the bot automatically switches
# to this node. Leave the host empty to run with a single node.
LAVALINK_BACKUP_HOST=
LAVALINK_BACKUP_PORT=2333
LAVALINK_BACKUP_PASS=youshallnotpass
LAVALINK_BACKUP_SECURE=false
LAVALINK_BACKUP_NAME=backup

# ── Optional: native Spotify resolution via LavaSrc ────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ═══════════════════════════════════════════════════════════════════
# FRONTEND (Vercel) — set in Vercel's project settings, NOT here
# ═══════════════════════════════════════════════════════════════════
# NEXT_PUBLIC_DISCORD_CLIENT_ID=<your discord application id>
# (Leave NEXT_PUBLIC_API_URL UNSET — vercel.json proxies /api/* to the
#  backend, keeping everything same-origin.)
#
# Also edit vercel.json: replace YOUR-WISPBYTE-ADDRESS:PORT with the
# backend's public address (e.g. http://212.227.166.131:10857).
#
# Discord Developer Portal → OAuth2 → redirect:
#   https://your-app.vercel.app/api/auth/callback
