# ── App ─────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
# Bind address for the HTTP server (hosting platforms: keep 0.0.0.0)
HOST=0.0.0.0

# ── Discord (https://discord.com/developers/applications) ───────────
# Enable the "Message Content" privileged intent on the Bot page.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# OAuth2 redirect URI on the Discord portal must be: ${APP_URL}/api/auth/callback

# ── Database ────────────────────────────────────────────────────────
# On hosting: use a MongoDB Atlas URI (mongodb+srv://...)
MONGODB_URI=mongodb://localhost:27017/slux

# ── Session ─────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Lavalink: main node (3rd-party) ─────────────────────────────────
# Use a hosted Lavalink provider. The node must run LavaSrc + LavaSearch
# + LavaLyrics plugins for search, source resolution and lyrics.
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASS=youshallnotpass
# Set true for TLS (wss/https) nodes — most hosted nodes use this.
LAVALINK_SECURE=false
# Label for the node (shown in /nodes and logs)
LAVALINK_NAME=main

# ── Lavalink: optional backup node (automatic failover) ─────────────
# When the main node is offline or busy, the bot automatically switches
# to this node (and back when the main recovers). Leave the host empty
# to run with a single node.
LAVALINK_BACKUP_HOST=
LAVALINK_BACKUP_PORT=2333
LAVALINK_BACKUP_PASS=youshallnotpass
LAVALINK_BACKUP_SECURE=false
LAVALINK_BACKUP_NAME=backup

# ── Optional: native Spotify resolution via LavaSrc ────────────────
# The Lavalink provider must also be configured with these credentials.
# Without them, Spotify URLs resolve via ISRC fallback to YouTube.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
