# ═══════════════════════════════════════════════════════════════════
# BACKEND (bot + API + socket) — deploy anywhere that runs Node 20+
# ═══════════════════════════════════════════════════════════════════
NODE_ENV=development

# Public URL of the BACKEND. The Discord OAuth redirect must be exactly:
#   ${APP_URL}/api/auth/callback
APP_URL=http://localhost:3001

# Bind address for the HTTP server (hosting platforms: keep 0.0.0.0)
HOST=0.0.0.0

# ── Discord (https://discord.com/developers/applications) ───────────
# Enable the "Message Content" privileged intent on the Bot page.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Only needed when the dashboard is enabled
DISCORD_CLIENT_SECRET=

# ── Database ────────────────────────────────────────────────────────
# MongoDB Atlas works great for split deployments
MONGODB_URI=mongodb://localhost:27017/slux

# ── Session ─────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Only needed when the dashboard is enabled
SESSION_SECRET=

# ── Dashboard ───────────────────────────────────────────────────────
# Master switch: set false to run a pure bot — no API, no socket server,
# no dashboard links in embeds, and no OAuth secrets required.
DASHBOARD_ENABLED=true

# Where the dashboard frontend is hosted (your Vercel URL, e.g.
# https://slux.vercel.app). Used for bot embed links, the post-login
# redirect and CORS. Falls back to APP_URL when empty.
DASHBOARD_URL=

# ── Lavalink: main node (3rd-party) ─────────────────────────────────
# The node must run LavaSrc + LavaSearch + LavaLyrics plugins.
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASS=youshallnotpass
# Set true for TLS (wss/https) nodes — most hosted nodes use this.
LAVALINK_SECURE=false
LAVALINK_NAME=main

# ── Lavalink: optional backup node (automatic failover) ─────────────
# When the main node is offline or busy, the bot automatically switches
# to this node. Leave the host empty to run with a single node.
LAVALINK_BACKUP_HOST=
LAVALINK_BACKUP_PORT=2333
LAVALINK_BACKUP_PASS=youshallnotpass
LAVALINK_BACKUP_SECURE=false
LAVALINK_BACKUP_NAME=backup

# ── Optional: native Spotify resolution via LavaSrc ────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ═══════════════════════════════════════════════════════════════════
# FRONTEND (Vercel) — set these in Vercel's project settings, NOT here
# ═══════════════════════════════════════════════════════════════════
# NEXT_PUBLIC_API_URL=https://your-backend.example.com
# NEXT_PUBLIC_DISCORD_CLIENT_ID=your discord application id
#
# Discord Developer Portal → OAuth2 → add redirect:
#   https://your-backend.example.com/api/auth/callback
